def convertir_linea(linea):
    """Convierte una línea T de la estación terrena en un dato válido."""
    match = PATRON_TELEMETRIA.match(linea.strip())
    if match is None:
        return None
    try:
        datos = match.groupdict()
        if datos["valido"] != "1":
            return None
        dato = {
            "tiempo": datetime.now(),
            "version": int(datos["version"]),
            "equipo": int(datos["equipo"]),
            "arranque": int(datos["arranque"]),
            "pkt": int(datos["pkt"]),
            "sensor_valido": int(datos["valido"]),
            "temperatura_C": float(datos["temperatura"]),
            "presion_hPa": float(datos["presion"]),
            "altitud_m": float(datos["altitud"]),
            "pico_m": float(datos["pico"]),
            "servo": int(datos["servo"]),
            "buzzer": int(datos["zumbador"]),
            "vuelo": int(datos["vuelo"]),
        }
        if dato["presion_hPa"] <= 0 or not all(
            np.isfinite(dato[nombre])
            for nombre in ("temperatura_C", "presion_hPa", "altitud_m")
        ):
            return None
        return dato
    except (ValueError, TypeError):
        return None




def hilo_lectura_serial():
    import serial
    global serial_activo


    ser = None
    while True:
        if ser is None:
            try:
                print(f"[Serial] Conectando a {SERIAL_PORT} @ {BAUD_RATE}...")
                ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
                with serial_lock:
                    serial_activo = ser
                estado_conexion["conectado"] = True
                estado_conexion["ultimo_error"] = None
                time.sleep(2)
                ser.reset_input_buffer()
                print("[Serial] Conectado correctamente")
            except serial.SerialException as error:
                estado_conexion["conectado"] = False
                estado_conexion["ultimo_error"] = str(error)
                print(f"[Serial] No se pudo abrir {SERIAL_PORT}: {error}")
                time.sleep(RECONNECT_DELAY_S)
                continue


        try:
            linea = ser.readline().decode("utf-8", errors="ignore").strip()
            if not linea:
                continue
            with open(ARCHIVO_SERIE, "a", encoding="utf-8") as registro_serie:
                registro_serie.write(datetime.now().isoformat(timespec="milliseconds") + " " + linea + "\n")
            dato = convertir_linea(linea)
            if dato is None:
                print("[Estación]", linea)
            if dato is not None:
                cola_datos.put(dato)
        except serial.SerialException as error:
            print(f"[Serial] Conexión perdida: {error}")
            estado_conexion["conectado"] = False
            estado_conexion["ultimo_error"] = str(error)
            with serial_lock:
                serial_activo = None
            try:
                ser.close()
            except Exception:
                pass
            ser = None
            time.sleep(RECONNECT_DELAY_S)




def hilo_simulacion():
    paso = 0
    while True:
        presion = 1013.25 - paso * 0.15 + np.random.normal(0, 0.4)
        cola_datos.put({
            "tiempo": datetime.now(),
            "pkt": paso,
            "temperatura_C": 22 + 2.5 * np.sin(paso / 20),
            "presion_hPa": presion,
            "altitud_m": 44330 * (1 - (presion / 1013.25) ** (1 / 5.255)),
        })
        estado_conexion["conectado"] = True
        paso += 1
        time.sleep(INTERVALO_MS / 1000)




