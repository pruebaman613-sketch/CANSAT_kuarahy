def enviar_comando(comando):
    with serial_lock:
        if serial_activo is None or not serial_activo.is_open:
            print("[Orden] Estación sin conexión")
            return
        try:
            serial_activo.write(comando.encode("ascii"))
            serial_activo.flush()
            print(f"[Orden] Enviada: {comando}. Comprobar telemetría y ACK.")
        except Exception as error:
            print(f"[Orden] No se pudo enviar: {error}")


