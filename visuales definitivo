def actualizar(_frame):
    global altitud_inicial, ultimo_arranque, inicio_contador_local, inicio_despegue_local, ultimo_estado, instante_ultimo_dato, ultimo_paquete_telemetria
    ultimo_dato = None
    actualizar_semaforo()


    while not cola_datos.empty():
        dato = cola_datos.get()
        if inicio_contador_local is None:
            inicio_contador_local = time.monotonic()
        if dato.get("arranque") != ultimo_arranque:
            ultimo_arranque = dato.get("arranque")
            altitud_inicial = None
            inicio_despegue_local = None
        if altitud_inicial is None:
            altitud_inicial = dato["altitud_m"]
            print(f"[Altitud] Referencia inicial: {altitud_inicial:.2f} m")


        altitud_relativa = dato["altitud_m"] - altitud_inicial
        if (
            inicio_despegue_local is None
            and altitud_relativa >= ALTITUD_DE_DESPEGUE_M
        ):
            inicio_despegue_local = time.monotonic()
            print(
                f"[Despegue] Altitud relativa alcanzó "
                f"{ALTITUD_DE_DESPEGUE_M:.1f} m"
            )
        tiempos.append(dato["tiempo"])
        temperaturas.append(dato["temperatura_C"])
        presiones.append(dato["presion_hPa"])
        altitud_mar = (ALTITUD_LUGAR_M + dato["altitud_m"]
                       if ALTITUD_LUGAR_M is not None else float("nan"))
        altitudes.append(altitud_mar)
        altitudes_relativas.append(dato["altitud_m"])
        registro = {**dato, "altitud_relativa_m": altitud_relativa,
                    "altitud_nivel_mar_estimada_m": altitud_mar}
        historico.append(registro)
        guardar_registro_csv(registro)
        ultimo_dato = dato
        ultimo_estado = dato
        instante_ultimo_dato = time.monotonic()
        ultimo_paquete_telemetria = instante_ultimo_dato


    if inicio_contador_local is None:
        texto_timer.set_text("00:00:00")
        texto_despegue.set_text("00:00:00")
        texto_status.set_text("No se sensó nada\nhasta el momento")
        texto_subtitulo.set_text(
            "Estación terrena · conectada, esperando telemetría"
            if estado_conexion["conectado"]
            else "Estación terrena · sin conexión al receptor"
        )
        return linea_temp, linea_pres, linea_alt_rel


    segundos = time.monotonic() - inicio_contador_local
    texto_timer.set_text(formato_tiempo(segundos))
    if inicio_despegue_local is None:
        texto_despegue.set_text("00:00:00")
        estado_despegue = "Esperando altitud relativa de 1 m"
    else:
        tiempo_despegue = time.monotonic() - inicio_despegue_local
        texto_despegue.set_text(formato_tiempo(tiempo_despegue))
        estado_despegue = "Despegue detectado"
    estado = ultimo_estado or {}
    texto_status.set_text(
        ("SIN TELEMETRÍA RECIENTE\n" if time.monotonic() - instante_ultimo_dato > TIEMPO_SIN_TELEMETRIA_S else "") +
        f"Paquete {estado.get('pkt', '--')}\n"
        f"Vuelo: {'ARMADO' if estado.get('vuelo') == 1 else 'DESARMADO'}\n"
        f"Servo: {'abierto' if estado.get('servo') == 1 else 'cerrado'}\n"
        f"Buzzer: {'forzado' if estado.get('buzzer') == 1 else 'automático'}"
    )
    texto_temp.set_text(f"{temperaturas[-1]:.2f} °C")
    texto_pres.set_text(f"{presiones[-1]:.2f} hPa")
    texto_alt_rel.set_text(f"{altitudes_relativas[-1]:.2f} m")
    texto_subtitulo.set_text("Estación terrena · sin telemetría reciente" if time.monotonic() - instante_ultimo_dato > TIEMPO_SIN_TELEMETRIA_S else "Estación terrena · recibiendo telemetría")


    linea_temp.set_data(tiempos, temperaturas)
    linea_pres.set_data(tiempos, presiones)
    linea_alt_rel.set_data(tiempos, altitudes_relativas)
    # Ajuste explícito de los ejes. Esto evita que el eje compartido deje
    # invisible la curva de temperatura cuando llegan pocos puntos.
    if tiempos:
        inicio = mdates.date2num(tiempos[0])
        fin = mdates.date2num(tiempos[-1])
        margen_x = max((fin - inicio) * 0.04, 1 / 86400)
        limite_x = (inicio - margen_x, fin + margen_x)


        for axis, values in (
            (ax_temp, temperaturas), (ax_pres, presiones),
            (ax_alt_rel, altitudes_relativas),
        ):
            valores = np.asarray(values, dtype=float)
            valores = valores[np.isfinite(valores)]
            if not len(valores):
                continue
            minimo = float(np.min(valores))
            maximo = float(np.max(valores))
            margen_y = max((maximo - minimo) * 0.15, 0.05)
            axis.set_xlim(limite_x)
            axis.set_ylim(minimo - margen_y, maximo + margen_y)
    return linea_temp, linea_pres, linea_alt_rel




def formatear_registro_csv(registro):
    registro_csv = dict(registro)
    if isinstance(registro_csv.get("tiempo"), datetime):
        registro_csv["tiempo"] = registro_csv["tiempo"].isoformat(
            sep=" ", timespec="milliseconds"
        )
    return {columna: registro_csv.get(columna, "") for columna in COLUMNAS_CSV}




def iniciar_csv():
    try:
        with open(ARCHIVO_CSV, "w", newline="", encoding="utf-8") as archivo:
            csv.DictWriter(archivo, fieldnames=COLUMNAS_CSV).writeheader()
        print(f"[CSV] Archivo iniciado: {os.path.abspath(ARCHIVO_CSV)}")
    except OSError as error:
        print(f"[CSV] No se pudo iniciar el archivo: {error}")




def guardar_registro_csv(registro):
    try:
        with archivo_csv_lock, open(
            ARCHIVO_CSV, "a", newline="", encoding="utf-8"
        ) as archivo:
            escritor = csv.DictWriter(archivo, fieldnames=COLUMNAS_CSV)
            escritor.writerow(formatear_registro_csv(registro))
            archivo.flush()
            os.fsync(archivo.fileno())
    except OSError as error:
        print(f"[CSV] No se pudo guardar el registro: {error}")




def guardar_historico():
    if not historico:
        print("[CSV] No hay registros para guardar")
        return
    temporal = None
    try:
        carpeta = os.path.dirname(os.path.abspath(ARCHIVO_CSV)) or "."
        with archivo_csv_lock, tempfile.NamedTemporaryFile(
            mode="w", newline="", encoding="utf-8", delete=False,
            dir=carpeta, prefix="telemetria_", suffix=".tmp"
        ) as archivo:
            temporal = archivo.name
            escritor = csv.DictWriter(archivo, fieldnames=COLUMNAS_CSV)
            escritor.writeheader()
            escritor.writerows(formatear_registro_csv(registro) for registro in historico)
            archivo.flush()
            os.fsync(archivo.fileno())
        os.replace(temporal, ARCHIVO_CSV)
        print(f"[CSV] Guardados {len(historico)} registros en {ARCHIVO_CSV}")
    except OSError as error:
        print(f"[CSV] No se pudo guardar el historial final: {error}")
        if temporal and os.path.exists(temporal):
            os.remove(temporal)






